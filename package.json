{
  "name": "justatxt",
  "productName": "Just a txt",
  "version": "0.1.0",
  "description": "A tiny plain-text todo editor",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac",
    "release": "electron-vite build && APPLE_KEYCHAIN_PROFILE=justatxt electron-builder --mac",
    "site": "vite --config site/vite.config.mts",
    "site:build": "vite build --config site/vite.config.mts"
  },
  "build": {
    "appId": "com.justatxt.app",
    "productName": "Just a txt",
    "files": [
      "out/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "build/icon.png",
      "hardenedRuntime": true
    },
    "directories": {
      "buildResources": "build"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "Just-a-txt-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15"
  }
}
